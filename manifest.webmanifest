    { "src": "./icons/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "记一笔支出", "short_name": "记支出", "url": "./index.html?quick=expense", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "记一笔收入", "short_name": "记收入", "url": "./index.html?quick=income", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "看预算", "short_name": "预算", "url": "./index.html?quick=budget", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
